<UserControl x:Class="ScrcpyDeck.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource Bg}">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="إدارة التطبيقات" FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="DeviceHint" Text="عرض وتثبيت وحذف وتعطيل التطبيقات" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Content="تثبيت APK" Click="Install_Click"/>
                <Button x:Name="RefreshBtn" Style="{StaticResource GhostButton}" Content="تحديث" Click="Refresh_Click" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- filters -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="ScopeThird" Style="{StaticResource SegRadio}" Content="تطبيقات المستخدم" IsChecked="True" Checked="Scope_Changed"/>
            <RadioButton x:Name="ScopeSystem" Style="{StaticResource SegRadio}" Content="تطبيقات النظام" Checked="Scope_Changed"/>
            <RadioButton x:Name="ScopeAll" Style="{StaticResource SegRadio}" Content="الكل" Checked="Scope_Changed"/>
        </StackPanel>

        <!-- search -->
        <TextBox x:Name="SearchBox" Grid.Row="2" Style="{StaticResource Field}" Tag="ابحث باسم التطبيق أو الحزمة..." Margin="0,0,0,12" TextChanged="Search_Changed"/>

        <!-- list -->
        <Grid Grid.Row="3">
            <Border Style="{StaticResource Cardish}" Padding="0" Background="{StaticResource Card}">
                <ListBox x:Name="AppList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#141E31" BorderThickness="0,0,0,1" Padding="16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                            Background="{Binding BadgeBg}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Monogram}" FontSize="16" FontWeight="Bold"
                                                   Foreground="{Binding BadgeFg}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding PrettyName}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text}"/>
                                        <TextBlock Text="{Binding Package}" FontFamily="{StaticResource Mono}" FontSize="11"
                                                   Foreground="{StaticResource Muted}" FlowDirection="LeftToRight"
                                                   TextAlignment="Right" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GhostButton}" Content="إيقاف" Padding="10,6" FontSize="12"
                                                Tag="{Binding Package}" Click="ForceStop_Click"/>
                                        <Button Style="{StaticResource GhostButton}" Content="مسح البيانات" Padding="10,6" FontSize="12" Margin="6,0,0,0"
                                                Tag="{Binding Package}" Click="Clear_Click"/>
                                        <Button Style="{StaticResource GhostButton}" Content="تعطيل" Padding="10,6" FontSize="12" Margin="6,0,0,0"
                                                Tag="{Binding Package}" Click="Disable_Click"/>
                                        <Button Style="{StaticResource DangerButton}" Content="حذف" Padding="10,6" FontSize="12" Margin="6,0,0,0"
                                                Tag="{Binding Package}" Click="Uninstall_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border x:Name="LoadingOverlay" Background="#AA0A0E1A" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="جارٍ التحميل..." FontSize="14" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
