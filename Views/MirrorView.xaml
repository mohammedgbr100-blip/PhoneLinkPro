<UserControl x:Class="ScrcpyDeck.Views.MirrorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource Bg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="بث الشاشة" FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="DeviceHint" Text="اختر مستوى الجودة وابدأ البث فوراً" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- quality presets -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource Cardish}" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonUp="Preset_Click" Tag="low">
                    <StackPanel>
                        <TextBlock Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="منخفض" FontSize="15" FontWeight="Bold" Margin="0,10,0,2"/>
                        <TextBlock Text="1024p · 4M · 30fps" FontSize="11" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="لاتصال ضعيف / بطارية" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Cardish}" Margin="6,0" Cursor="Hand" MouseLeftButtonUp="Preset_Click" Tag="medium">
                    <StackPanel>
                        <TextBlock Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource Adb}"/>
                        <TextBlock Text="متوسط" FontSize="15" FontWeight="Bold" Margin="0,10,0,2"/>
                        <TextBlock Text="1280p · 8M · 60fps" FontSize="11" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="متوازن للاستخدام اليومي" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border x:Name="HighCard" Style="{StaticResource Cardish}" Margin="6,0" Cursor="Hand" MouseLeftButtonUp="Preset_Click" Tag="high"
                        BorderBrush="{StaticResource Scrcpy}">
                    <StackPanel>
                        <TextBlock Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource Scrcpy}"/>
                        <TextBlock Text="عالٍ ★" FontSize="15" FontWeight="Bold" Margin="0,10,0,2" Foreground="{StaticResource Scrcpy}"/>
                        <TextBlock Text="1920p · 16M · 60fps" FontSize="11" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="الأفضل للأغلب (USB)" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Cardish}" Margin="6,0,0,0" Cursor="Hand" MouseLeftButtonUp="Preset_Click" Tag="ultra">
                    <StackPanel>
                        <TextBlock Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource Accent}"/>
                        <TextBlock Text="Ultra" FontSize="15" FontWeight="Bold" Margin="0,10,0,2" Foreground="{StaticResource Accent}"/>
                        <TextBlock Text="2560p · 32M · 60fps" FontSize="11" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="أعلى جودة (USB قوي)" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- quick options -->
            <Border Grid.Row="2" Style="{StaticResource Cardish}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="خيارات سريعة" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <UniformGrid Columns="2">
                        <CheckBox x:Name="OptTurnOff" Style="{StaticResource Switch}" Content="إطفاء شاشة الهاتف أثناء البث" Margin="0,0,0,12"/>
                        <CheckBox x:Name="OptStayAwake" Style="{StaticResource Switch}" Content="إبقاء الهاتف مستيقظاً" Margin="0,0,0,12"/>
                        <CheckBox x:Name="OptFullscreen" Style="{StaticResource Switch}" Content="ملء الشاشة" Margin="0,0,0,12"/>
                        <CheckBox x:Name="OptOnTop" Style="{StaticResource Switch}" Content="دائماً في المقدمة" Margin="0,0,0,12"/>
                        <CheckBox x:Name="OptNoAudio" Style="{StaticResource Switch}" Content="بدون صوت" Margin="0,0,0,12"/>
                        <CheckBox x:Name="OptShowTouches" Style="{StaticResource Switch}" Content="إظهار مؤشرات اللمس" Margin="0,0,0,12"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- command preview + launch -->
            <Border Grid.Row="3" Style="{StaticResource Cardish}" Background="#0B1220">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="ملخّص الإعدادات" FontSize="10" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="CmdPreview" Text="—" FontSize="13" Foreground="{StaticResource Adb}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock x:Name="SessionHint" Text="" FontSize="11.5" Foreground="{StaticResource Scrcpy}"
                                   Margin="0,6,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="StopBtn" Style="{StaticResource DangerButton}" Click="Stop_Click"
                            VerticalAlignment="Center" Margin="16,0,0,0" Padding="18,13" IsEnabled="False"
                            ToolTip="إنهاء جميع جلسات البث الجارية">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="إيقاف البث" FontSize="13" FontWeight="Bold" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" x:Name="StartBtn" Style="{StaticResource PrimaryButton}" Click="Start_Click"
                            VerticalAlignment="Center" Margin="10,0,0,0" Padding="26,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="ابدأ البث" FontSize="15" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
