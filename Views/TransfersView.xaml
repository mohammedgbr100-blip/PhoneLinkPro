<UserControl x:Class="ScrcpyDeck.Views.TransfersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource Brush.App.Background}"
             AutomationProperties.Name="نقل الملفات">
    <UserControl.Resources>
        <!-- ===================== bounded local dark TextBox/ComboBox styles =====================
             Same precedent WirelessView established (Batch 4C Phase 8): a small, page-scoped
             dark style rather than a larger, unreviewed global change. -->
        <Style x:Key="TextBox.Transfers" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="Background" Value="{StaticResource Brush.Surface.Inset}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="{StaticResource Size.ControlHeight}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CaretBrush" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="{StaticResource Opacity.Disabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBoxItem.Transfers" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Surface.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Surface.Selected}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Bright}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBox.Transfers" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="Background" Value="{StaticResource Brush.Surface.Inset}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}"/>
            <Setter Property="MinHeight" Value="{StaticResource Size.ControlHeight}"/>
            <Setter Property="Padding" Value="10,0,32,0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItem.Transfers}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{StaticResource Brush.Surface.Inset}"
                                                BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1"
                                                CornerRadius="{StaticResource Radius.Control}"
                                                MinHeight="{StaticResource Size.ControlHeight}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Width="9" Height="5" Stretch="Fill"
                                                      Data="M 0,0 L 4.5,5 L 9,0 Z"
                                                      Fill="{StaticResource Brush.Text.Muted}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent.Primary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Stretch"/>

                            <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="None"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border x:Name="DropDownBorder" Background="{StaticResource Brush.Surface.RaisedAlt}"
                                        BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Control}"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260" SnapsToDevicePixels="True">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Text.FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="Text.FieldError" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.State.Danger}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource Thickness.PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== header ===================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="نقل الملفات" Style="{StaticResource Text.PageTitle}"/>
            <TextBlock Text="أرسل ملفات إلى هاتفك أو اسحب ملفاً منه — بأمان، دون تشغيل أي شيء تلقائياً"
                       Style="{StaticResource Text.PageSubtitle}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ===================== body ===================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="820" HorizontalAlignment="Center">

                <!-- ======== tools-unavailable banner ======== -->
                <Border x:Name="ToolsUnavailableBanner" Visibility="Collapsed" Margin="0,0,0,14"
                        Background="{StaticResource Brush.Banner.DangerBackground}"
                        BorderBrush="{StaticResource Brush.Banner.DangerBorder}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path x:Name="ToolsUnavailableIcon" Grid.Column="0" Style="{StaticResource Shell.Icon}"
                              Data="{StaticResource Icon.Warning}"
                              Stroke="{StaticResource Brush.Banner.DangerText}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ToolsUnavailableText" Grid.Column="1"
                                   Text="تعذّر العثور على أدوات الاتصال بالجهاز داخل البرنامج — هذه ليست مشكلة في هاتفك، بل في ملفات البرنامج على هذا الحاسوب. الإرسال والاستلام والتحقّق معطّلة حتى يتم إصلاحها."
                                   Foreground="{StaticResource Brush.Banner.DangerText}" TextWrapping="Wrap"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ======== current status ======== -->
                <Border x:Name="StatusBanner" Style="{StaticResource Card.Surface}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Style="{StaticResource Indicator.Dot}" VerticalAlignment="Center"/>
                            <Path x:Name="StatusIcon" Style="{StaticResource Shell.Icon}" Width="16" Height="16"
                                  Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource Text.Body}" Margin="10,0,0,0"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ======== device selector ======== -->
                <Border Style="{StaticResource Card.Surface}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="الجهاز" Style="{StaticResource Text.Body}" FontWeight="Bold" FontSize="16"/>
                        <TextBlock x:Name="NoDevicesText" Text="لا يوجد جهاز أندرويد متصل بعد."
                                   Style="{StaticResource Text.Secondary}" Margin="0,8,0,0"/>
                        <StackPanel x:Name="DeviceSelectorList" Margin="0,8,0,0"/>
                        <Button x:Name="GoToWirelessBtn" Style="{StaticResource Button.Ghost}"
                                Content="الانتقال إلى إعداد الاتصال اللاسلكي" Click="GoToWireless_Click"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed"
                                AutomationProperties.Name="الانتقال إلى صفحة إعداد الاتصال اللاسلكي بالجهاز"/>
                    </StackPanel>
                </Border>

                <!-- ======== Send card ======== -->
                <Border Style="{StaticResource Card.Surface}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="إرسال إلى الهاتف" Style="{StaticResource Text.Body}" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="اختر ملفاً واحداً أو أكثر من الحاسوب، ثم وجهة على الهاتف"
                                   Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,12"/>

                        <Button x:Name="ChooseFilesBtn" Style="{StaticResource Button.Ghost}" Content="اختيار ملفات"
                                Click="ChooseFiles_Click" HorizontalAlignment="Left" TabIndex="1"
                                AutomationProperties.Name="اختيار ملفات من الحاسوب لإرسالها إلى الهاتف"/>
                        <TextBlock x:Name="SelectedFilesCountText" Text="لم يتم اختيار ملفات بعد."
                                   Style="{StaticResource Text.Secondary}" Margin="0,8,0,0"/>
                        <ItemsControl x:Name="SelectedFilesList" Margin="0,4,0,0" IsTabStop="False" Focusable="False"/>

                        <TextBlock Text="الوجهة على الهاتف" Style="{StaticResource Text.FieldLabel}" Margin="0,12,0,4"/>
                        <ComboBox x:Name="DestinationCombo" Style="{StaticResource ComboBox.Transfers}" TabIndex="2"
                                  SelectionChanged="Destination_Changed"
                                  AutomationProperties.Name="اختيار وجهة الملفات على الهاتف"/>

                        <StackPanel x:Name="CustomDestinationPanel" Visibility="Collapsed" Margin="0,10,0,0">
                            <TextBlock Text="مسار مخصّص على الهاتف" Style="{StaticResource Text.FieldLabel}"/>
                            <TextBox x:Name="CustomDestinationBox" Style="{StaticResource TextBox.Transfers}"
                                     FlowDirection="LeftToRight" ToolTip="مثال: /sdcard/Download/مجلد"
                                     TextChanged="CustomDestination_Changed"
                                     AutomationProperties.Name="مسار مخصّص على الهاتف"
                                     AutomationProperties.HelpText="مسار مطلق على مساحة تخزين الهاتف يبدأ بـ /sdcard/ أو /storage/emulated/0/"/>
                            <TextBlock x:Name="CustomDestinationError" Style="{StaticResource Text.FieldError}"/>
                        </StackPanel>

                        <TextBlock x:Name="SendResultText" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                                   Margin="0,10,0,0" Visibility="Collapsed"/>

                        <Button x:Name="SendBtn" Style="{StaticResource Button.Primary}" Content="إرسال"
                                Click="Send_Click" HorizontalAlignment="Left" Margin="0,12,0,0" TabIndex="3"
                                AutomationProperties.Name="إرسال الملفات المختارة إلى الهاتف"/>
                    </StackPanel>
                </Border>

                <!-- ======== Receive card ======== -->
                <Border Style="{StaticResource Card.Surface}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="استلام من الهاتف" Style="{StaticResource Text.Body}" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="أدخل المسار الكامل للملف كما يظهر في مدير الملفات على هاتفك، ثم اختر مكان الحفظ"
                                   Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,12"/>

                        <TextBlock Text="مسار الملف على الهاتف" Style="{StaticResource Text.FieldLabel}"/>
                        <TextBox x:Name="ReceiveRemotePathBox" Style="{StaticResource TextBox.Transfers}"
                                 FlowDirection="LeftToRight" ToolTip="مثال: /sdcard/DCIM/Camera/photo.jpg"
                                 TabIndex="4" TextChanged="ReceiveRemotePath_Changed"
                                 AutomationProperties.Name="مسار الملف الكامل على الهاتف"
                                 AutomationProperties.HelpText="أدخل المسار الكامل والدقيق كما يعرضه مدير الملفات على الهاتف — لا يوجد تصفّح عن بُعد"/>
                        <TextBlock x:Name="ReceiveRemotePathError" Style="{StaticResource Text.FieldError}"/>

                        <Button x:Name="ChooseSaveLocationBtn" Style="{StaticResource Button.Ghost}" Content="اختيار مكان الحفظ"
                                Click="ChooseSaveLocation_Click" HorizontalAlignment="Left" Margin="0,10,0,0" TabIndex="5"
                                AutomationProperties.Name="اختيار مكان حفظ الملف على الحاسوب"/>
                        <TextBlock x:Name="ReceiveDestinationText" Text="لم يتم اختيار مكان الحفظ بعد."
                                   Style="{StaticResource Text.Secondary}" Margin="0,8,0,0"/>

                        <TextBlock x:Name="ReceiveResultText" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                                   Margin="0,10,0,0" Visibility="Collapsed"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="ReceiveBtn" Style="{StaticResource Button.Primary}" Content="استلام"
                                    Click="Receive_Click" TabIndex="6"
                                    AutomationProperties.Name="استلام الملف من الهاتف"/>
                            <Button x:Name="VerifyBtn" Style="{StaticResource Button.Ghost}" Content="تحقّق من الجهاز"
                                    Click="Verify_Click" Margin="8,0,0,0" TabIndex="7"
                                    AutomationProperties.Name="التحقّق من حالة الجهاز الآن"/>
                            <Button x:Name="CancelBtn" Style="{StaticResource Button.GhostDanger}" Content="إلغاء"
                                    Click="Cancel_Click" Margin="8,0,0,0" Visibility="Collapsed" TabIndex="8"
                                    AutomationProperties.Name="إلغاء عملية النقل الحالية"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ======== current-session results ======== -->
                <Border Style="{StaticResource Card.Surface}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="نتائج هذه الجلسة" Style="{StaticResource Text.Body}"
                                       FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                            <Button x:Name="ClearResultsBtn" Grid.Column="1" Style="{StaticResource Button.Ghost}"
                                    Content="مسح النتائج" Click="ClearResults_Click"
                                    AutomationProperties.Name="مسح قائمة نتائج هذه الجلسة"/>
                        </Grid>
                        <TextBlock x:Name="NoResultsText" Text="لا توجد عمليات نقل في هذه الجلسة بعد."
                                   Style="{StaticResource Text.Secondary}" Margin="0,8,0,0"/>
                        <ItemsControl x:Name="ResultsList" Margin="0,8,0,0" IsTabStop="False" Focusable="False"/>
                    </StackPanel>
                </Border>

                <!-- ======== privacy / security note ======== -->
                <Border Style="{StaticResource Card.Surface}" Background="{StaticResource Brush.Surface.RaisedAlt}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Style="{StaticResource Shell.Icon}" Data="{StaticResource Icon.Shield}"
                                  Width="16" Height="16" Stroke="{StaticResource Brush.Text.Muted}"/>
                            <TextBlock Text="حقائق مهمة قبل المتابعة" Style="{StaticResource Text.Body}" FontWeight="Bold"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ItemsControl IsTabStop="False" Focusable="False">
                            <ItemsControl.Items>
                                <TextBlock Text="• لا يوجد استعراض لملفات الهاتف عن بُعد — أدخل المسار الدقيق كما يظهر في مدير الملفات على هاتفك."
                                           Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                <TextBlock Text="• لا يتم فتح أو تشغيل أي ملف تلقائياً بعد النقل — سواء على الهاتف أو الحاسوب."
                                           Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                <TextBlock Text="• عند الاستلام، تختار موقع الحفظ بنفسك، وسيُطلب تأكيدك قبل استبدال أي ملف موجود."
                                           Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                <TextBlock Text="• لا تُحفظ مسارات الملفات أو سجل النقل بعد إغلاق البرنامج."
                                           Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                <TextBlock Text="• تثبيت التطبيقات (APK) غير مدعوم من هذه الصفحة — استخدم صفحة إدارة التطبيقات."
                                           Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </ItemsControl.Items>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
