<UserControl x:Class="ScrcpyDeck.Views.WirelessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource Brush.App.Background}"
             AutomationProperties.Name="الاتصال اللاسلكي">
    <UserControl.Resources>
        <!-- ===================== bounded local dark TextBox/PasswordBox styles =====================
             No global TextBox/PasswordBox style exists yet (Batch 4C Phase 8) — this mirrors the
             precedent set by DeviceSetupWizardWindow's local "ComboBox.SetupWizard" style: a
             small, page-scoped dark style rather than a larger, unreviewed global change. -->
        <Style x:Key="TextBox.Wireless" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="Background" Value="{StaticResource Brush.Surface.Inset}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="{StaticResource Size.ControlHeight}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CaretBrush" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="{StaticResource Opacity.Disabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PasswordBox.Wireless" TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="Background" Value="{StaticResource Brush.Surface.Inset}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="{StaticResource Size.ControlHeight}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="PasswordChar" Value="•"/>
            <Setter Property="CaretBrush" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="{StaticResource Opacity.Disabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- small caption used for the "field:" labels above each input -->
        <Style x:Key="Text.FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- inline per-field validation error -->
        <Style x:Key="Text.FieldError" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.State.Danger}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource Thickness.PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== header ===================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="الاتصال اللاسلكي" Style="{StaticResource Text.PageTitle}"/>
            <TextBlock Text="أقرِن هذا الكمبيوتر بهاتفك ثم اتصل به عبر شبكة Wi-Fi — دون كابل"
                       Style="{StaticResource Text.PageSubtitle}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ===================== body ===================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="820" HorizontalAlignment="Center">

                <!-- ======== tools-unavailable banner ========
                     M4 repair: a horizontal StackPanel offers its children INFINITE available
                     width on the stacking axis during measure, so a TextWrapping="Wrap"
                     TextBlock inside one never actually wraps — it is measured as one long line
                     and then clipped when arranged back into the real (bounded) width. An
                     explicit Grid with an Auto icon column and a Star text column bounds the
                     text column's available width, so it wraps correctly and the banner grows
                     vertically instead of clipping horizontally at 920/1200/1440 DIP. -->
                <Border x:Name="ToolsUnavailableBanner" Visibility="Collapsed" Margin="0,0,0,14"
                        Background="{StaticResource Brush.Banner.DangerBackground}"
                        BorderBrush="{StaticResource Brush.Banner.DangerBorder}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path x:Name="ToolsUnavailableIcon" Grid.Column="0" Style="{StaticResource Shell.Icon}"
                              Data="{StaticResource Icon.Warning}"
                              Stroke="{StaticResource Brush.Banner.DangerText}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ToolsUnavailableText" Grid.Column="1"
                                   Text="تعذّر العثور على أدوات الاتصال بالجهاز داخل البرنامج — هذه ليست مشكلة في هاتفك، بل في ملفات البرنامج على هذا الحاسوب. الإقران والاتصال معطّلان حتى يتم إصلاحها."
                                   Foreground="{StaticResource Brush.Banner.DangerText}" TextWrapping="Wrap"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ======== current status ======== (same Grid-based wrap fix as above) -->
                <Border x:Name="StatusBanner" Style="{StaticResource Card.Surface}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Style="{StaticResource Indicator.Dot}" VerticalAlignment="Center"/>
                            <Path x:Name="StatusIcon" Style="{StaticResource Shell.Icon}" Width="16" Height="16"
                                  Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource Text.Body}" Margin="10,0,0,0"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ======== numbered Android instructions ======== -->
                <Border Style="{StaticResource Card.Surface}" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Path Style="{StaticResource Shell.Icon}" Data="{StaticResource Icon.Wireless}"
                                  Width="18" Height="18" Stroke="{StaticResource Brush.Accent.Primary}"/>
                            <TextBlock Text="خطوات تفعيل التصحيح اللاسلكي على الهاتف" Style="{StaticResource Text.Body}"
                                       FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,4">
                            الإعدادات ← خيارات المطوّر ← التصحيح اللاسلكي ← إقران الجهاز برمز الإقران
                        </TextBlock>
                        <TextBlock Text="تختلف التسميات قليلاً بين الشركات المصنّعة وإصدارات أندرويد."
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ======== Pair card ======== -->
                <Border Style="{StaticResource Card.Surface}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="إقران هذا الكمبيوتر" Style="{StaticResource Text.Body}" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="أدخل رمز الإقران المؤقت ومنفذ الإقران الظاهرَين على شاشة الهاتف الآن"
                                   Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,12"/>

                        <TextBlock Text="عنوان IP للهاتف" Style="{StaticResource Text.FieldLabel}"/>
                        <TextBox x:Name="PairHostBox" Style="{StaticResource TextBox.Wireless}" FlowDirection="LeftToRight"
                                 ToolTip="مثال: 192.168.1.23" TabIndex="0"
                                 TextChanged="PairText_Changed"
                                 AutomationProperties.Name="عنوان IP للهاتف — بطاقة الإقران"/>
                        <TextBlock x:Name="PairHostError" Style="{StaticResource Text.FieldError}"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="منفذ الإقران المؤقت" Style="{StaticResource Text.FieldLabel}"/>
                                <TextBox x:Name="PairPortBox" Style="{StaticResource TextBox.Wireless}" FlowDirection="LeftToRight"
                                         ToolTip="مثال: 37123" TabIndex="1" TextChanged="PairText_Changed"
                                         PreviewKeyDown="PairPort_PreviewKeyDown"
                                         AutomationProperties.Name="منفذ الإقران المؤقت"
                                         AutomationProperties.HelpText="منفذ الإقران المؤقت الظاهر على شاشة الهاتف أثناء الإقران فقط — يختلف عن منفذ الاتصال العادي أدناه"/>
                                <TextBlock x:Name="PairPortError" Style="{StaticResource Text.FieldError}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="رمز الإقران (٦ أرقام)" Style="{StaticResource Text.FieldLabel}"/>
                                <PasswordBox x:Name="PairCodeBox" Style="{StaticResource PasswordBox.Wireless}"
                                             TabIndex="2" PasswordChanged="PairCode_Changed"
                                             PreviewKeyDown="PairCode_PreviewKeyDown"
                                             AutomationProperties.Name="رمز الإقران المكوّن من ستة أرقام"/>
                                <TextBlock x:Name="PairCodeError" Style="{StaticResource Text.FieldError}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="PairResultText" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                                   Margin="0,10,0,0" Visibility="Collapsed"/>

                        <Button x:Name="PairBtn" Style="{StaticResource Button.Primary}" Content="إقران"
                                Click="Pair_Click" HorizontalAlignment="Left" Margin="0,12,0,0" TabIndex="3"
                                AutomationProperties.Name="إقران هذا الكمبيوتر بالهاتف"/>
                    </StackPanel>
                </Border>

                <!-- ======== Connect card ======== -->
                <Border Style="{StaticResource Card.Surface}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="الاتصال بالهاتف المُقرَن" Style="{StaticResource Text.Body}" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="بعد الإقران، استخدم منفذ الاتصال اللاسلكي العادي — وهو مختلف عن منفذ الإقران أعلاه"
                                   Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,12"/>

                        <TextBlock Text="عنوان IP للهاتف" Style="{StaticResource Text.FieldLabel}"/>
                        <TextBox x:Name="ConnectHostBox" Style="{StaticResource TextBox.Wireless}" FlowDirection="LeftToRight"
                                 ToolTip="مثال: 192.168.1.23" TabIndex="4" TextChanged="ConnectField_Changed"
                                 AutomationProperties.Name="عنوان IP للهاتف — بطاقة الاتصال"/>
                        <TextBlock x:Name="ConnectHostError" Style="{StaticResource Text.FieldError}"/>

                        <TextBlock Text="منفذ الاتصال اللاسلكي" Style="{StaticResource Text.FieldLabel}" Margin="0,10,0,4"/>
                        <TextBox x:Name="ConnectPortBox" Style="{StaticResource TextBox.Wireless}" FlowDirection="LeftToRight"
                                 ToolTip="مثال: 5555" HorizontalAlignment="Left" Width="160" TabIndex="5"
                                 TextChanged="ConnectField_Changed" PreviewKeyDown="ConnectPort_PreviewKeyDown"
                                 AutomationProperties.Name="منفذ الاتصال اللاسلكي"
                                 AutomationProperties.HelpText="منفذ التصحيح اللاسلكي الحالي على الهاتف — يختلف عن منفذ الإقران المؤقت أعلاه"/>
                        <TextBlock x:Name="ConnectPortError" Style="{StaticResource Text.FieldError}"/>

                        <TextBlock x:Name="ConnectResultText" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                                   Margin="0,10,0,0" Visibility="Collapsed"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="ConnectBtn" Style="{StaticResource Button.Primary}" Content="اتصال"
                                    Click="Connect_Click" TabIndex="6"
                                    AutomationProperties.Name="الاتصال بالهاتف عبر Wi-Fi"/>
                            <Button x:Name="VerifyBtn" Style="{StaticResource Button.Ghost}" Content="تحقّق من الظهور"
                                    Click="Verify_Click" Margin="8,0,0,0" Visibility="Collapsed" TabIndex="7"
                                    AutomationProperties.Name="التحقّق من ظهور الجهاز الآن"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ======== connected devices ======== -->
                <Border Style="{StaticResource Card.Surface}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="الأجهزة اللاسلكية المكتشَفة" Style="{StaticResource Text.Body}" FontWeight="Bold" FontSize="16"/>
                        <TextBlock x:Name="NoWirelessDevicesText" Text="لا يوجد جهاز لاسلكي مكتشَف بعد."
                                   Style="{StaticResource Text.Secondary}" Margin="0,8,0,0"/>
                        <StackPanel x:Name="DeviceSelectorList" Margin="0,8,0,0"/>
                        <Button x:Name="GoToDashboardBtn" Style="{StaticResource Button.Primary}"
                                Content="الانتقال إلى لوحة التحكم" Click="GoToDashboard_Click"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed"
                                AutomationProperties.Name="الانتقال إلى لوحة التحكم بالجهاز المحدد"/>
                    </StackPanel>
                </Border>

                <!-- ======== privacy / security note ======== -->
                <Border Style="{StaticResource Card.Surface}" Background="{StaticResource Brush.Surface.RaisedAlt}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Style="{StaticResource Shell.Icon}" Data="{StaticResource Icon.Shield}"
                                  Width="16" Height="16" Stroke="{StaticResource Brush.Text.Muted}"/>
                            <TextBlock Text="حقائق مهمة قبل المتابعة" Style="{StaticResource Text.Body}" FontWeight="Bold"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ItemsControl IsTabStop="False" Focusable="False">
                            <ItemsControl.Items>
                                <TextBlock Text="• الإقران اللاسلكي لا يتجاوز خيارات المطوّر — يجب تفعيل «التصحيح اللاسلكي» على الهاتف أولاً."
                                           Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                <TextBlock Text="• منفذ الإقران المؤقت ومنفذ الاتصال العادي غالباً مختلفان — لا تفترض أنهما متطابقان."
                                           Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                <TextBlock Text="• نجاح الإقران لا يعني أن الهاتف متصل الآن — الاتصال خطوة منفصلة."
                                           Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                <TextBlock Text="• يجب أن يكون الهاتف والحاسوب عادةً على نفس الشبكة المحلية."
                                           Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                <TextBlock Text="• لا يمكن لـ PhoneLink Pro تفعيل التصحيح اللاسلكي على الهاتف عن بُعد — هذا إجراء يقوم به المستخدم يدوياً على جهازه."
                                           Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                <TextBlock Text="• رمز الإقران لا يُحفظ ولا يُسجَّل في أي مكان؛ ولا يتم حفظ عناوين IP أو المنافذ بعد إغلاق البرنامج."
                                           Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </ItemsControl.Items>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
