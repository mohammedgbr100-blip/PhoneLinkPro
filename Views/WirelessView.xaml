<UserControl x:Class="ScrcpyDeck.Views.WirelessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource Bg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24" MaxWidth="720" HorizontalAlignment="Right">
            <StackPanel>
                <TextBlock Text="الاتصال اللاسلكي" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="تحكّم بهاتفك عبر Wi-Fi بدون كابل" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,18"/>

                <!-- Automatic wizard -->
                <Border Style="{StaticResource Cardish}" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Background="#13273D" CornerRadius="6" Width="30" Height="30">
                                <TextBlock Text="&#xE704;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource Scrcpy}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="التحويل التلقائي (موصى به)" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="وصّل الهاتف بالكابل مرة واحدة، ثم اضغط الزر" FontSize="12" Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Background="#0B1220" CornerRadius="8" Padding="14" Margin="0,10,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource Scrcpy}" VerticalAlignment="Center"/>
                                    <TextBlock Text="1) وصّل الهاتف بكابل USB وفعّل تصحيح USB" FontSize="12.5" Foreground="{StaticResource Text}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource Scrcpy}" VerticalAlignment="Center"/>
                                    <TextBlock Text="2) تأكد أن الهاتف والحاسوب على نفس شبكة Wi-Fi" FontSize="12.5" Foreground="{StaticResource Text}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource Scrcpy}" VerticalAlignment="Center"/>
                                    <TextBlock Text="3) اضغط «تفعيل الاتصال اللاسلكي» — يمكنك بعدها نزع الكابل" FontSize="12.5" Foreground="{StaticResource Text}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button x:Name="AutoBtn" Style="{StaticResource PrimaryButton}" Click="Auto_Click" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE704;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="تفعيل الاتصال اللاسلكي" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Manual connect -->
                <Border Style="{StaticResource Cardish}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="اتصال يدوي" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="إذا كنت تعرف عنوان IP للهاتف والمنفذ" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="IpBox" Grid.Column="0" Style="{StaticResource Field}" Tag="192.168.1.x"
                                     FlowDirection="LeftToRight"/>
                            <TextBox x:Name="PortBox" Grid.Column="1" Style="{StaticResource Field}" Text="5555" Margin="8,0"
                                     FlowDirection="LeftToRight"/>
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="اتصال" Click="Connect_Click" Padding="18,10"/>
                            <Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="قطع" Click="Disconnect_Click" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Pairing -->
                <Border Style="{StaticResource Cardish}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="الإقران (أندرويد 11 وأحدث)" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="من إعدادات المطوّر ← تصحيح لاسلكي ← إقران بجهاز برمز" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PairIpBox" Grid.Column="0" Style="{StaticResource Field}" Tag="192.168.1.x:37xxx"
                                     FlowDirection="LeftToRight"/>
                            <TextBox x:Name="PairCodeBox" Grid.Column="1" Style="{StaticResource Field}" Tag="رمز الإقران" Margin="8,0"
                                     FlowDirection="LeftToRight"/>
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="إقران" Click="Pair_Click" Padding="18,10"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- log -->
                <Border Style="{StaticResource Cardish}" Background="#0B1220">
                    <StackPanel>
                        <TextBlock Text="سجل العمليات" FontSize="11" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                        <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource Text}" FontFamily="{StaticResource Mono}" FontSize="12"
                                 FlowDirection="LeftToRight" TextWrapping="Wrap" MinHeight="80"
                                 VerticalScrollBarVisibility="Auto" Text="جاهز."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
