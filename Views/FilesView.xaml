<UserControl x:Class="ScrcpyDeck.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource Bg}">
  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24" MaxWidth="760" HorizontalAlignment="Right">
            <StackPanel>
                <TextBlock Text="نقل الملفات" FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="DeviceHint" Text="انقل الملفات بين الحاسوب والهاتف" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,18"/>

                <!-- PUSH -->
                <Border Style="{StaticResource Cardish}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="رفع إلى الهاتف" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Scrcpy}"/>
                        <TextBlock Text="اسحب الملفات هنا أو اضغط للاختيار" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,12"/>

                        <Border x:Name="DropZone" Height="120" CornerRadius="12" Background="#0B1220"
                                BorderBrush="#25344D" BorderThickness="1.5" AllowDrop="True"
                                Cursor="Hand" Drop="Drop_File" DragEnter="Drop_Enter" DragLeave="Drop_Leave"
                                MouseLeftButtonUp="Pick_File">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{StaticResource Adb}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="DropLabel" Text="أفلت الملفات هنا" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="الوجهة على الهاتف:" FontSize="12.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="RemoteDirBox" Grid.Column="1" Style="{StaticResource Field}" Text="/sdcard/Download/" FlowDirection="LeftToRight"/>
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="رفع" Click="Push_Click" Margin="8,0,0,0" Padding="20,10"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- PULL -->
                <Border Style="{StaticResource Cardish}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="سحب من الهاتف" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Scrcpy}"/>
                        <TextBlock Text="أدخل مسار الملف على الهاتف واختر مجلد الحفظ" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,12"/>

                        <TextBlock Text="مسار الملف على الهاتف:" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                        <TextBox x:Name="PullRemoteBox" Style="{StaticResource Field}" Tag="مثال: /sdcard/DCIM/Camera/photo.jpg" FlowDirection="LeftToRight"/>

                        <TextBlock Text="مجلد الحفظ في الحاسوب:" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,12,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LocalDirBox" Grid.Column="0" Style="{StaticResource Field}" FlowDirection="LeftToRight"/>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="تصفّح" Click="BrowseLocal_Click" Margin="8,0,0,0"/>
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="سحب" Click="Pull_Click" Margin="8,0,0,0" Padding="20,10"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- log -->
                <Border Style="{StaticResource Cardish}" Background="#0B1220">
                    <StackPanel>
                        <TextBlock Text="سجل النقل" FontSize="11" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                        <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource Text}" FontFamily="{StaticResource Mono}" FontSize="12"
                                 FlowDirection="LeftToRight" TextWrapping="Wrap" MinHeight="70"
                                 VerticalScrollBarVisibility="Auto" Text="جاهز."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>

    <!-- transfer progress overlay -->
    <Border x:Name="BusyOverlay" Background="#D00A0B0F" Visibility="Collapsed">
        <Border Style="{StaticResource Cardish}" Background="{StaticResource Card}" MaxWidth="360"
                VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
            <StackPanel>
                <Image x:Name="BusyLogo" Width="46" Height="46" HorizontalAlignment="Center"/>
                <TextBlock x:Name="BusyTitle" Text="جارٍ النقل..." FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,14,0,4"/>
                <TextBlock x:Name="BusyFile" Text="" FontSize="12" Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Height="6" Margin="0,16,0,0"
                             Background="#0C0D11" Foreground="{StaticResource Adb}" BorderThickness="0"/>
                <TextBlock x:Name="BusyCount" Text="" FontSize="11" FontFamily="{StaticResource Mono}"
                           Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Border>
  </Grid>
</UserControl>
