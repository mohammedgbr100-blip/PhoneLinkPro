<UserControl x:Class="ScrcpyDeck.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:ScrcpyDeck.Services"
             FlowDirection="RightToLeft"
             Background="{StaticResource Brush.App.Background}"
             AutomationProperties.Name="الإعدادات">
    <UserControl.Resources>
        <!-- local dark ComboBox style, mirrors the page-scoped precedent in WirelessView/DeviceSetupWizardWindow -->
        <Style x:Key="Combo.Settings" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="Background" Value="{StaticResource Brush.Surface.Inset}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="{StaticResource Size.ControlHeight}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{StaticResource Brush.Surface.Inset}"
                                                BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1"
                                                CornerRadius="{StaticResource Radius.Control}">
                                            <Grid Margin="10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                                                                   ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                   VerticalAlignment="Center" Margin="0"/>
                                                <Path Grid.Column="0" Data="M4,6 L8,10 L12,6" Stroke="{StaticResource Brush.Text.Muted}"
                                                      StrokeThickness="1.6" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                                        <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border Background="{StaticResource Brush.Surface.RaisedAlt}"
                                        BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Control}" MinWidth="{TemplateBinding ActualWidth}"
                                        Margin="0,4,0,0">
                                    <ScrollViewer Margin="4" MaxHeight="240">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Surface.Hover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- status row: dot + label, used by the read-only engine-status card -->
        <Style x:Key="StatusRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- small caption used for the "field:" labels above each input (mirrors WirelessView's page-scoped precedent) -->
        <Style x:Key="Text.FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="Text.CardHeading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
        </Style>

        <!-- inline confirm panel shared by Reset and Clear-logs -->
        <Style x:Key="ConfirmPanel" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Background" Value="{StaticResource Brush.Banner.DangerBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Banner.DangerBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource Thickness.PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== header ===================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="الإعدادات" Style="{StaticResource Text.PageTitle}"/>
            <TextBlock Text="تفضيلات التطبيق الحقيقية فقط — كل ما تراه هنا مطبَّق فعلياً، ولا شيء منها زخرفي"
                       Style="{StaticResource Text.PageSubtitle}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ===================== body ===================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="820" HorizontalAlignment="Center" Margin="0,0,0,8">

                <!-- ======== General ======== -->
                <Border Style="{StaticResource Card.Surface}" Margin="0,0,0,14"
                        AutomationProperties.Name="عام">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Style="{StaticResource Shell.Icon}" Data="{StaticResource Icon.Info}"
                                  Width="18" Height="18" Stroke="{StaticResource Brush.Accent.Primary}"/>
                            <TextBlock Text="عام" Style="{StaticResource Text.CardHeading}" Margin="8,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="حالة الموافقة على سياسة الخصوصية" Style="{StaticResource Text.FieldLabel}"/>
                        <TextBlock x:Name="ConsentStatusText" Style="{StaticResource Text.Body}" Margin="0,0,0,4"
                                   AutomationProperties.Name="حالة الموافقة على سياسة الخصوصية"/>
                        <TextBlock Text="لا يمكن سحب الموافقة من هذه الصفحة — هذا الحقل للعرض فقط."
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <Border Style="{StaticResource Divider.Horizontal}" Margin="0,0,0,14"/>

                        <TextBlock Text="جولة الترحيب التمهيدية" Style="{StaticResource Text.FieldLabel}"/>
                        <TextBlock x:Name="OnboardingStatusText" Style="{StaticResource Text.Body}" Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>
                        <Button x:Name="ShowTourAgainBtn" Content="إظهار جولة الترحيب مرة أخرى"
                                Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                Click="ShowTourAgain_Click"
                                AutomationProperties.Name="إظهار جولة الترحيب مرة أخرى"
                                AutomationProperties.HelpText="يعرض جولة الترحيب في المرة القادمة لفتح البرنامج. إجراء آمن وقابل للتكرار، ولا يمسّ موافقتك على سياسة الخصوصية."/>
                        <TextBlock x:Name="TourResetFailedText" Visibility="Collapsed" Margin="0,8,0,0"
                                   Foreground="{StaticResource Brush.State.Danger}" TextWrapping="Wrap"
                                   Text="تعذّر حفظ هذا التغيير. تحقّق من صلاحيات الملف وحاول مرة أخرى."/>
                    </StackPanel>
                </Border>

                <!-- ======== Appearance (read-only — no fake selector) ======== -->
                <Border Style="{StaticResource Card.Surface}" Margin="0,0,0,14"
                        AutomationProperties.Name="المظهر واللغة">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Style="{StaticResource Shell.Icon}" Data="{StaticResource Icon.Settings}"
                                  Width="18" Height="18" Stroke="{StaticResource Brush.Accent.Primary}"/>
                            <TextBlock Text="المظهر واللغة" Style="{StaticResource Text.CardHeading}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="السمة الداكنة هي سمة البرنامج الوحيدة حالياً — لا يوجد اختيار آخر ليُعرض هنا."
                                   Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock Text="واجهة البرنامج بالعربية فقط باتجاه RTL؛ القيم التقنية (الإصدارات، الأرقام التسلسلية) تُعرض دائماً بالاتجاه LTR."
                                   Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ======== Device & operations ======== -->
                <Border Style="{StaticResource Card.Surface}" Margin="0,0,0,14"
                        AutomationProperties.Name="الجهاز والعمليات">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Path Style="{StaticResource Shell.Icon}" Data="{StaticResource Icon.Folder}"
                                      Width="18" Height="18" Stroke="{StaticResource Brush.Accent.Primary}"/>
                                <TextBlock Text="الجهاز والعمليات" Style="{StaticResource Text.CardHeading}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <Border x:Name="UnsavedPill" Grid.Column="0" HorizontalAlignment="Left" Visibility="Collapsed"
                                    Background="{StaticResource Brush.Banner.DangerBackground}"
                                    CornerRadius="{StaticResource Radius.Badge}" Padding="8,3">
                                <TextBlock Text="تغييرات غير محفوظة" FontSize="{StaticResource FontSize.Caption}"
                                           Foreground="{StaticResource Brush.State.Warning}"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="وجهة نقل الملفات الافتراضية" Style="{StaticResource Text.FieldLabel}"/>
                        <ComboBox x:Name="DestinationCombo" Style="{StaticResource Combo.Settings}"
                                  SelectionChanged="Destination_Changed" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="وجهة نقل الملفات الافتراضية"
                                  AutomationProperties.HelpText="المجلد الذي تُقترَح إليه الملفات المُرسَلة تلقائياً في صفحة نقل الملفات. يمكن تغييره لكل عملية نقل بغضّ النظر عن هذا الإعداد."/>
                        <TextBlock Text="يُستخدم كاقتراح مبدئي فقط في صفحة نقل الملفات — لا يقيّد اختيارك هناك في أي عملية نقل بعينها."
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ======== Privacy & diagnostics ======== -->
                <Border Style="{StaticResource Card.Surface}" Margin="0,0,0,14"
                        AutomationProperties.Name="الخصوصية والتشخيص">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Style="{StaticResource Shell.Icon}" Data="{StaticResource Icon.Shield}"
                                  Width="18" Height="18" Stroke="{StaticResource Brush.Accent.Primary}"/>
                            <TextBlock Text="الخصوصية والتشخيص" Style="{StaticResource Text.CardHeading}" Margin="8,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="لا يخزّن البرنامج أبداً: الأرقام التسلسلية للأجهزة، عناوين الاتصال اللاسلكي، رموز الإقران، مسارات الملفات المحلية أو البعيدة، سجلّ عمليات النقل، أو مخرجات التشخيص الخام."
                                   Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="OpenLogFolderBtn" Content="فتح مجلد السجلات" Style="{StaticResource Button.Ghost}"
                                    Click="OpenLogFolder_Click"
                                    AutomationProperties.Name="فتح مجلد السجلات"
                                    AutomationProperties.HelpText="يفتح مجلد ملفات سجلّ التشخيص المحلية في مستكشف الملفات."/>
                            <Button x:Name="ClearLogsBtn" Content="مسح السجلات" Style="{StaticResource Button.GhostDanger}"
                                    Margin="10,0,0,0" Click="ClearLogsRequest_Click"
                                    AutomationProperties.Name="مسح السجلات"
                                    AutomationProperties.HelpText="يحذف ملفات سجلّ التشخيص المحلية نهائياً بعد تأكيد صريح."/>
                        </StackPanel>
                        <TextBlock x:Name="OpenLogFolderFailedText" Visibility="Collapsed" Margin="0,8,0,0"
                                   Foreground="{StaticResource Brush.State.Danger}" TextWrapping="Wrap"
                                   Text="تعذّر فتح مجلد السجلات."/>

                        <Border x:Name="ClearLogsConfirmPanel" Style="{StaticResource ConfirmPanel}"
                                AutomationProperties.Name="تأكيد مسح السجلات">
                            <StackPanel>
                                <TextBlock Text="مسح جميع ملفات السجلّ المحلية نهائياً؟ لا يمكن التراجع عن هذا الإجراء."
                                           Foreground="{StaticResource Brush.Banner.DangerText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button x:Name="ClearLogsConfirmCancelBtn" Content="إلغاء" Style="{StaticResource Button.Ghost}"
                                            Click="ClearLogsConfirmCancel_Click"
                                            AutomationProperties.Name="إلغاء مسح السجلات"/>
                                    <Button x:Name="ClearLogsConfirmProceedBtn" Content="مسح نهائياً" Style="{StaticResource Button.Danger}"
                                            Margin="10,0,0,0" Click="ClearLogsConfirmProceed_Click"
                                            AutomationProperties.Name="تأكيد مسح السجلات نهائياً"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="ClearLogsFailedText" Visibility="Collapsed" Margin="0,10,0,0"
                                   Foreground="{StaticResource Brush.State.Danger}" TextWrapping="Wrap"
                                   Text="تعذّر مسح ملفات السجلّ. تحقق من أن الملفات غير مستخدَمة من برنامج آخر."/>
                    </StackPanel>
                </Border>

                <!-- ======== Local engine status (read-only) ======== -->
                <Border Style="{StaticResource Card.Surface}" Margin="0,0,0,14"
                        AutomationProperties.Name="حالة محرّك البرنامج">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Style="{StaticResource Shell.Icon}" Data="{StaticResource Icon.Shield}"
                                  Width="18" Height="18" Stroke="{StaticResource Brush.Accent.Primary}"/>
                            <TextBlock Text="حالة محرّك البرنامج" Style="{StaticResource Text.CardHeading}" Margin="8,0,0,0"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource StatusRow}" AutomationProperties.Name="حالة أدوات المحرّك">
                            <Ellipse x:Name="ToolsStatusDot" Style="{StaticResource Indicator.Dot}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ToolsStatusText" Style="{StaticResource Text.Body}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource StatusRow}" AutomationProperties.Name="حالة التحقق من سلامة الملفات">
                            <Ellipse x:Name="IntegrityStatusDot" Style="{StaticResource Indicator.Dot}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="IntegrityStatusText" Style="{StaticResource Text.Body}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="EngineVersionLabelText" Text="{x:Static services:EngineManifest.FormatVersionLabelArabic}" Style="{StaticResource Text.Caption}"/>
                                <TextBlock x:Name="EngineVersionText" Style="{StaticResource Text.Mono}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="إصدار التطبيق" Style="{StaticResource Text.Caption}"/>
                                <TextBlock x:Name="AppVersionText" Style="{StaticResource Text.Mono}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ======== Reset ======== -->
                <Border Style="{StaticResource Card.Surface}" Margin="0,0,0,14"
                        AutomationProperties.Name="استعادة الإعدادات الافتراضية">
                    <StackPanel>
                        <TextBlock Text="استعادة الإعدادات الافتراضية" Style="{StaticResource Text.CardHeading}" Margin="0,0,0,8"/>
                        <TextBlock Text="يعيد «وجهة نقل الملفات الافتراضية» فقط إلى التنزيلات. لا يمسّ الموافقة على السياسة، ولا حالة جولة الترحيب، ولا السجلّات."
                                   Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Button x:Name="ResetPreferencesBtn" Content="استعادة الإعدادات الافتراضية" Style="{StaticResource Button.Ghost}"
                                HorizontalAlignment="Left" Click="ResetPreferences_Click"
                                AutomationProperties.Name="استعادة الإعدادات الافتراضية"
                                AutomationProperties.HelpText="يعيد وجهة نقل الملفات الافتراضية إلى التنزيلات بعد تأكيد صريح. لا يمسّ أي بيانات أخرى."/>

                        <Border x:Name="ResetConfirmPanel" Style="{StaticResource ConfirmPanel}"
                                AutomationProperties.Name="تأكيد استعادة الإعدادات الافتراضية">
                            <StackPanel>
                                <TextBlock Text="سيتم تغيير «وجهة نقل الملفات الافتراضية» إلى التنزيلات. هل تريد المتابعة؟"
                                           Foreground="{StaticResource Brush.Banner.DangerText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button x:Name="ResetConfirmCancelBtn" Content="إلغاء" Style="{StaticResource Button.Ghost}"
                                            Click="ResetConfirmCancel_Click"
                                            AutomationProperties.Name="إلغاء الاستعادة"/>
                                    <Button x:Name="ResetConfirmProceedBtn" Content="استعادة الآن" Style="{StaticResource Button.Danger}"
                                            Margin="10,0,0,0" Click="ResetConfirmProceed_Click"
                                            AutomationProperties.Name="تأكيد الاستعادة الآن"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="ResetFailedText" Visibility="Collapsed" Margin="0,10,0,0"
                                   Foreground="{StaticResource Brush.State.Danger}" TextWrapping="Wrap"
                                   Text="تعذّرت الاستعادة. حاول مرة أخرى."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===================== Save/Cancel footer ===================== -->
        <Border Grid.Row="2" Background="{StaticResource Brush.Surface.RaisedAlt}"
                BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,1,0,0"
                Padding="0,14,0,0" Margin="0,10,0,0">
            <Grid MaxWidth="820" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SaveStatusText" Grid.Column="1" Style="{StaticResource Text.Secondary}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           AutomationProperties.Name="حالة الحفظ" AutomationProperties.LiveSetting="Polite"/>
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="CancelBtn" Content="إلغاء" Style="{StaticResource Button.Ghost}"
                            Click="Cancel_Click" AutomationProperties.Name="إلغاء التغييرات"/>
                    <Button x:Name="SaveBtn" Content="حفظ" Style="{StaticResource Button.Primary}"
                            Margin="10,0,0,0" Click="Save_Click" AutomationProperties.Name="حفظ الإعدادات"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
