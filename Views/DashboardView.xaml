<UserControl x:Class="ScrcpyDeck.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource Bg}">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="لوحة الأجهزة" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                <TextBlock Text="الأجهزة المتصلة عبر USB أو Wi-Fi — اختر جهازاً للتحكم به" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource GhostButton}"
                    Click="Refresh_Click" x:Name="RefreshBtn">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="تحديث" Margin="7,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- status / empty -->
                <Border x:Name="EmptyState" Style="{StaticResource Cardish}" Padding="30" Margin="0,0,0,10" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyText" Text="لا توجد أجهزة متصلة" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                        <TextBlock Text="وصّل هاتفك عبر USB وفعّل تصحيح USB، أو استخدم تبويب الاتصال اللاسلكي." FontSize="12.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                        <Button Style="{StaticResource GhostButton}" Content="شاهد الشرح التعليمي" Margin="0,16,0,0" Click="Help_Click"/>
                    </StackPanel>
                </Border>

                <ItemsControl x:Name="DeviceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Cardish}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- icon -->
                                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12" Background="#13273D" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource Adb}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- info -->
                                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                                            <Border Background="#13273D" CornerRadius="5" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ConnectionLabel}" FontSize="10" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Adb}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Serial}" FontSize="11" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding AndroidVersion, StringFormat='أندرويد {0}'}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="5,0,16,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Resolution}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="5,0,16,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="&#xE83F;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Battery, StringFormat='{}{0}%'}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- actions -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                        <StackPanel Margin="0,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                         Fill="{Binding IsAuthorized, Converter={StaticResource BoolToStateColor}}"/>
                                                <TextBlock Text="{Binding StateLabel}" FontSize="11" Foreground="{StaticResource Muted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Style="{StaticResource PrimaryButton}" Content="تحديد وبثّ" Padding="16,10"
                                                Tag="{Binding Serial}" Click="SelectAndMirror_Click"
                                                IsEnabled="{Binding IsAuthorized}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
