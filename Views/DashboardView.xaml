<UserControl x:Class="ScrcpyDeck.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ScrcpyDeck.Converters"
             FlowDirection="RightToLeft"
             Background="{StaticResource Brush.App.Background}">
    <UserControl.Resources>
        <conv:MaskSerialConverter x:Key="MaskSerial"/>
        <conv:SafeDeviceLabelConverter x:Key="SafeDeviceLabel"/>
    </UserControl.Resources>

    <Grid Margin="{StaticResource Thickness.PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== header ===================== -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="لوحة الأجهزة" Style="{StaticResource Text.PageTitle}"/>
                <TextBlock Text="إدارة الأجهزة المتصلة واختيار جهاز للبث والتحكم"
                           Style="{StaticResource Text.PageSubtitle}" Margin="0,4,0,0"/>
                <TextBlock x:Name="LoadingHint" Text="جارٍ البحث عن الأجهزة…" Visibility="Collapsed"
                           Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.Accent.Primary}"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource Button.Ghost}"
                    Click="Refresh_Click" x:Name="RefreshBtn" AutomationProperties.Name="تحديث قائمة الأجهزة">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Shell.Icon}" Data="{StaticResource Icon.Refresh}"
                          Width="{StaticResource Size.IconSmall}" Height="{StaticResource Size.IconSmall}"
                          VerticalAlignment="Center"/>
                    <TextBlock Text="تحديث" Style="{StaticResource Shell.ButtonContentText}"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ===================== body ===================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- ======== selected-device hero (Direction D "dev-stage") ======== -->
                <Border MinHeight="260" CornerRadius="{StaticResource Radius.Panel}"
                        BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1"
                        Background="{StaticResource Brush.DeviceSpace.Surface}">
                    <Grid Margin="24">

                        <!-- empty variant -->
                        <StackPanel x:Name="HeroEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MaxWidth="480">
                            <Grid Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Ellipse Stroke="{StaticResource Brush.Border.Subtle}" StrokeThickness="1"/>
                                <Ellipse Width="64" Height="64" Stroke="{StaticResource Brush.Border.Subtle}" StrokeThickness="1"/>
                                <Path Style="{StaticResource Shell.Icon}" Data="{StaticResource Icon.Device}"
                                      Width="34" Height="34" Stroke="{StaticResource Brush.Text.Muted}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="HeroEmptyTitle" Text="لا توجد أجهزة متصلة" Style="{StaticResource Text.Body}"
                                       FontSize="{StaticResource FontSize.Title}" FontWeight="Bold"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock Text="وصّل هاتفك عبر USB وفعّل تصحيح USB، أو استخدم تبويب الاتصال اللاسلكي."
                                       Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <Button Style="{StaticResource Button.Ghost}" Content="إعداد الهاتف خطوة بخطوة"
                                    Margin="0,16,0,0" HorizontalAlignment="Center" Click="Help_Click"
                                    AutomationProperties.Name="إعداد الهاتف خطوة بخطوة"/>
                        </StackPanel>

                        <!-- live variant: compact Direction D composition — phone (right) · identity
                             (middle) · action (left), capped and centered so wide windows never
                             leave a dead void between the identity and its own action button. -->
                        <Grid x:Name="HeroLive" Visibility="Collapsed" HorizontalAlignment="Center"
                              VerticalAlignment="Center" MaxWidth="760">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto" MaxWidth="320"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- phone visualization: purely decorative. Border/Ellipse/Path/Grid/
                                 StackPanel have no built-in AutomationPeer implementation in WPF, so
                                 nothing in this subtree is ever exposed to UI Automation regardless of
                                 Name; Focusable="False" is what actually keeps it out of the keyboard
                                 tab order. -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,40,0"
                                        Focusable="False">
                                <Border Width="104" Height="192" CornerRadius="16"
                                        BorderBrush="#35496B" BorderThickness="1.5" Background="#101A2C">
                                    <Border Margin="6" CornerRadius="12">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#0C1322" Offset="0"/>
                                                <GradientStop Color="#0F1B30" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Ellipse Width="5" Height="5" Fill="#070C16" Stroke="#21304C" StrokeThickness="1"
                                                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,7,0,0"/>
                                    </Border>
                                </Border>

                                <!-- stat chips -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <Border Style="{StaticResource Card.Surface}" Padding="9,5" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="النظام" Style="{StaticResource Text.Caption}"/>
                                            <TextBlock x:Name="HeroAndroidText" Style="{StaticResource Text.Mono}"
                                                       Foreground="{StaticResource Brush.Text.Primary}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card.Surface}" Padding="9,5">
                                        <StackPanel>
                                            <TextBlock Text="الدقة" Style="{StaticResource Text.Caption}"/>
                                            <TextBlock x:Name="HeroResolutionText" Style="{StaticResource Text.Mono}"
                                                       Foreground="{StaticResource Brush.Text.Primary}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- battery -->
                                <Border x:Name="HeroBattery" Style="{StaticResource Card.Surface}" Padding="8,5"
                                        Margin="0,8,0,0" HorizontalAlignment="Center"
                                        AutomationProperties.Name="نسبة شحن البطارية">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="HeroBatteryTrack" Width="60" Height="4" CornerRadius="2"
                                                Background="{StaticResource Brush.Border.Subtle}" VerticalAlignment="Center">
                                            <Border x:Name="HeroBatteryFill" Width="0" Height="4" CornerRadius="2"
                                                    HorizontalAlignment="Left"
                                                    Background="{StaticResource Brush.State.Success}"/>
                                        </Border>
                                        <TextBlock x:Name="HeroBatteryVal" Style="{StaticResource Text.Mono}"
                                                   Foreground="{StaticResource Brush.Text.Secondary}" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- identity -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,28,0"
                                        MaxWidth="320">
                                <TextBlock x:Name="HeroDeviceLabel" Text="الجهاز الحالي" Style="{StaticResource Text.Caption}"/>
                                <TextBlock x:Name="HeroDeviceName" Style="{StaticResource Text.Body}"
                                           FontSize="19" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                           Margin="0,4,0,7"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                    <Ellipse x:Name="HeroStateDot" Style="{StaticResource Indicator.Dot}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HeroStateText" Style="{StaticResource Text.Body}"
                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Border x:Name="HeroUnauthorizedHint" Visibility="Collapsed" Margin="0,0,0,7"
                                        BorderBrush="{StaticResource Brush.State.Warning}" BorderThickness="1"
                                        Background="{StaticResource Brush.Accent.SoftBackground}"
                                        CornerRadius="{StaticResource Radius.Control}" Padding="10,6"
                                        MaxWidth="280" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Shell.Icon}" Data="{StaticResource Icon.Warning}"
                                              Width="15" Height="15" Stroke="{StaticResource Brush.State.Warning}"/>
                                        <TextBlock Text="اقبل طلب الإذن الظاهر على شاشة الهاتف" Margin="8,0,0,0"
                                                   FontSize="{StaticResource FontSize.BodySmall}"
                                                   Foreground="{StaticResource Brush.State.Warning}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="HeroSerial" Style="{StaticResource Text.Mono}" VerticalAlignment="Center"/>
                                    <Button x:Name="HeroRevealBtn" Style="{StaticResource Button.Icon}"
                                            Margin="4,0,0,0" Click="RevealSerial_Click" ToolTip="إظهار الرقم التسلسلي"
                                            AutomationProperties.Name="إظهار الرقم التسلسلي">
                                        <Path Style="{StaticResource Shell.Icon}" Data="{StaticResource Icon.Eye}" Width="13" Height="13"/>
                                    </Button>
                                    <Border Background="{StaticResource Brush.Surface.Inset}"
                                            BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Badge}" Padding="7,1" Margin="8,0,0,0">
                                        <TextBlock x:Name="HeroConnectionBadge" Style="{StaticResource Text.Mono}" FontSize="10"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- primary action: immediately adjacent to the identity it controls,
                                 never stretched across a dead void (M1 repair). -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button x:Name="HeroStartBtn" Style="{StaticResource Button.Primary}"
                                        Click="SelectAndMirror_Click" MinWidth="164" MinHeight="46"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Path Style="{StaticResource Shell.Icon}" Data="{StaticResource Icon.Mirror}"
                                              Width="17" Height="17"/>
                                        <TextBlock Text="بدء البث" Style="{StaticResource Shell.ButtonContentText}"
                                                   Margin="9,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ======== device list: every OTHER discovered device, never the hero above ======== -->
                <TextBlock x:Name="OthersHeading" Text="الأجهزة المكتشفة" Style="{StaticResource Text.Body}"
                           FontWeight="{StaticResource FontWeight.Medium}" Margin="0,18,0,10"/>

                <ItemsControl x:Name="DeviceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" CornerRadius="{StaticResource Radius.Card}"
                                    Background="{StaticResource Brush.Surface.Raised}" BorderThickness="1" Padding="16">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}"/>
                                        <Style.Triggers>
                                            <!-- other-device rows never render as "selected" — the hero
                                                 above is the only current/selected device presentation
                                                 (Direction D; M1 repair removed the dead accent-ring
                                                 trigger that could never match, since ApplyOtherDevicesList
                                                 always excludes the hero's own serial from this list). -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- icon -->
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="{StaticResource Radius.Card}"
                                            Background="{StaticResource Brush.Surface.Inset}" VerticalAlignment="Center">
                                        <Path Style="{StaticResource Shell.Icon}" Data="{StaticResource Icon.Device}"
                                              Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- info: a compact, physically-right-anchored identity stack
                                         (M4 repair) — under this UserControl's FlowDirection="RightToLeft",
                                         WPF mirrors the HorizontalAlignment axis, so the literal value
                                         "Left" is what renders on the physical right. That keeps this
                                         panel sized to its own content (bounded by the name's own
                                         MaxWidth) instead of stretching across the whole star column,
                                         and lands it immediately beside the device icon (Grid.Column="0",
                                         itself physically on the right under RTL) rather than beside the
                                         action button on the physical left. The masked serial stays a
                                         direct, immediate sibling of the name inside this same bounded
                                         container. -->
                                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center"
                                                HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Converter={StaticResource SafeDeviceLabel}}"
                                                       Style="{StaticResource Text.Body}"
                                                       FontWeight="{StaticResource FontWeight.Medium}" TextTrimming="CharacterEllipsis"
                                                       MaxWidth="260"/>
                                            <Border Background="{StaticResource Brush.Surface.Inset}"
                                                    BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1"
                                                    CornerRadius="{StaticResource Radius.Badge}" Padding="6,1" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding ConnectionLabel}" Style="{StaticResource Text.Mono}" FontSize="10"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Serial, Converter={StaticResource MaskSerial}}"
                                                   Style="{StaticResource Text.Mono}" Margin="0,3,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                            <Ellipse Style="{StaticResource Indicator.DotSmall}" VerticalAlignment="Center"
                                                     Margin="0,7,0,0">
                                                <Ellipse.Fill>
                                                    <Binding Path="IsAuthorized" Converter="{StaticResource BoolToStateColor}"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="{Binding StateLabel}" Style="{StaticResource Text.Secondary}"
                                                       Margin="6,7,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- action -->
                                    <Button Grid.Column="2" Style="{StaticResource Button.Ghost}" Content="تحديد وبثّ"
                                            Tag="{Binding Serial}" Click="SelectAndMirror_Click"
                                            IsEnabled="{Binding IsAuthorized}" VerticalAlignment="Center"
                                            AutomationProperties.Name="{Binding Converter={StaticResource SafeDeviceLabel}, StringFormat='تحديد وبثّ من {0}'}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
