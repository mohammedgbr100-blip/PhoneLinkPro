<Window x:Class="ScrcpyDeck.Windows.DeviceSetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعداد هاتف أندرويد"
        Width="820" Height="680" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent" FlowDirection="RightToLeft"
        FontFamily="{StaticResource Font.UI}"
        AutomationProperties.Name="إعداد هاتف أندرويد"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- ===================== B2 repair: bounded local dark ComboBox style =====================
             This is the only ComboBox in the app; a global Theme.xaml style would be a much
             larger, unreviewed change than this repair calls for, so the style lives here,
             scoped to this window only. Dropdown items get their own dark ItemContainerStyle so
             the popup never falls back to the light system chrome either. -->
        <Style x:Key="ComboBoxItem.SetupWizard" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Surface.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Surface.Selected}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Bright}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBox.SetupWizard" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            <!-- Background/BorderBrush are also set here (the template's own ToggleButton Border
                 paints from the same StaticResource directly, not a TemplateBinding) so the
                 ComboBox's OWN properties report the true dark colors too — the runtime self-test
                 checks these values directly rather than walking the template's visual tree. -->
            <Setter Property="Background" Value="{StaticResource Brush.Surface.Inset}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}"/>
            <Setter Property="MinHeight" Value="{StaticResource Size.ControlHeight}"/>
            <Setter Property="Padding" Value="10,0,32,0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItem.SetupWizard}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{StaticResource Brush.Surface.Inset}"
                                                BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1"
                                                CornerRadius="{StaticResource Radius.Control}"
                                                MinHeight="{StaticResource Size.ControlHeight}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Width="9" Height="5" Stretch="Fill"
                                                      Data="M 0,0 L 4.5,5 L 9,0 Z"
                                                      Fill="{StaticResource Brush.Text.Muted}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent.Primary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Stretch"/>

                            <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="None"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border x:Name="DropDownBorder" Background="{StaticResource Brush.Surface.RaisedAlt}"
                                        BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Control}"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260" SnapsToDevicePixels="True">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource Brush.Surface.RaisedAlt}"
            BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Dialog}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===================== title bar ===================== -->
            <!-- Explicit columns rather than mirrored HorizontalAlignment (B1 repair): under
                 this Window's RTL FlowDirection, Grid.Column="0" is the physical-right cell and
                 the last column is physical-left — the same convention MainWindow's own title
                 bar already uses. The title's column is a bounded "*" cell with trimming, so a
                 long title is clipped by ellipsis rather than ever growing into the close
                 button's dedicated Auto cell. -->
            <Grid Grid.Row="0" Margin="24,18,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Grid.Column="0" Text="إعداد هاتف أندرويد" Style="{StaticResource Text.PageTitle}"
                           FontSize="19" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Margin="0,0,12,0"/>
                <Button x:Name="CloseBtn" Grid.Column="1" VerticalAlignment="Top" TabIndex="0"
                        Style="{StaticResource Button.CaptionUtility}"
                        Click="Close_Click" ToolTip="إغلاق"
                        AutomationProperties.Name="إغلاق نافذة الإعداد">
                    <Path Style="{StaticResource Shell.Icon}" Data="{StaticResource Icon.Close}" Width="14" Height="14"/>
                </Button>
            </Grid>

            <!-- ===================== stepper (informational; not focusable — Back/Next drive navigation) ===================== -->
            <ItemsControl x:Name="StepperHost" Grid.Row="1" Margin="24,16,24,0" Focusable="False"
                          AutomationProperties.Name="خطوات الإعداد">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Focusable="False"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- ===================== live status banner ===================== -->
            <Border x:Name="StatusBanner" Grid.Row="2" Margin="24,14,24,0" Padding="12,10"
                    Background="{StaticResource Brush.Surface.Raised}"
                    CornerRadius="{StaticResource Radius.Control}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Style="{StaticResource Indicator.Dot}" VerticalAlignment="Center"/>
                        <Path x:Name="StatusIcon" Style="{StaticResource Shell.Icon}" Width="16" Height="16"
                              Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Style="{StaticResource Text.Body}" Margin="10,0,0,0"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="SupportLinkBtn" Style="{StaticResource Button.Ghost}" Content="فتح نافذة الدعم"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Click="SupportLink_Click" TabIndex="9"
                            Visibility="Collapsed" AutomationProperties.Name="فتح نافذة حول البرنامج والدعم"/>
                </StackPanel>
            </Border>

            <!-- ===================== multiple-device selector ===================== -->
            <Border x:Name="MultiDevicePanel" Grid.Row="3" Visibility="Collapsed" Margin="24,12,24,0"
                    Style="{StaticResource Card.Surface}">
                <StackPanel>
                    <TextBlock Text="تم اكتشاف أكثر من جهاز — اختر الجهاز الذي تريد إعداده:"
                               Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                    <StackPanel x:Name="DeviceSelectorList" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- ===================== body: one step panel visible at a time ===================== -->
            <ScrollViewer Grid.Row="4" Margin="24,16,24,0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- step 0: توصيل الهاتف -->
                    <StackPanel x:Name="StepConnectPanel">
                        <TextBlock Text="وصّل هاتفك بالحاسوب" Style="{StaticResource Text.Body}" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,8,0,0">
                            استخدم كابل USB يدعم نقل البيانات (بعض الكابلات مخصّصة للشحن فقط ولا تصلح للاتصال).
                            بمجرد توصيل الكابل ستظهر هنا حالة الاتصال تلقائياً.
                        </TextBlock>
                        <Border Style="{StaticResource Card.Surface}" Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="جارٍ انتظار توصيل الهاتف…" x:Name="ConnectWaitingText"
                                           Style="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- step 1: تفعيل خيارات المطوّر -->
                    <StackPanel x:Name="StepDevOptionsPanel" Visibility="Collapsed">
                        <TextBlock Text="تفعيل خيارات المطوّر" Style="{StaticResource Text.Body}" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="نوع الهاتف:" Style="{StaticResource Text.Caption}" Margin="0,12,0,4"/>
                        <ComboBox x:Name="ManufacturerCombo" Width="280" HorizontalAlignment="Left" TabIndex="2"
                                  Style="{StaticResource ComboBox.SetupWizard}"
                                  SelectionChanged="ManufacturerCombo_SelectionChanged"
                                  AutomationProperties.Name="اختر الشركة المصنّعة لهاتفك"
                                  AutomationProperties.HelpText="يغيّر هذا فقط نص الشرح المعروض؛ لا يكتشف نوع هاتفك تلقائياً"/>
                        <ItemsControl x:Name="DevOptionsBullets" Margin="0,12,0,0"/>
                    </StackPanel>

                    <!-- step 2: تفعيل تصحيح USB -->
                    <StackPanel x:Name="StepUsbDebugPanel" Visibility="Collapsed">
                        <TextBlock Text="تفعيل تصحيح USB" Style="{StaticResource Text.Body}" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="نفس نوع الهاتف المختار في الخطوة السابقة:" Style="{StaticResource Text.Caption}" Margin="0,12,0,4"/>
                        <ItemsControl x:Name="UsbDebugBullets" Margin="0,8,0,0"/>
                        <TextBlock Text="لم يكتشف الحاسوب أي تغيير؟ أعد توصيل الكابل بعد التفعيل."
                                   Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- step 3: السماح لهذا الكمبيوتر -->
                    <StackPanel x:Name="StepAuthorizePanel" Visibility="Collapsed">
                        <TextBlock Text="السماح لهذا الكمبيوتر" Style="{StaticResource Text.Body}" FontWeight="Bold" FontSize="16"/>
                        <ItemsControl x:Name="AuthorizeBullets" Margin="0,10,0,0"/>
                        <Border Style="{StaticResource Card.Surface}" Margin="0,14,0,0"
                                BorderBrush="{StaticResource Brush.State.Warning}">
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource Text.Secondary}"
                                       Foreground="{StaticResource Brush.State.Warning}">
                                يمكنك تفعيل «السماح دائماً من هذا الكمبيوتر» على مربع الحوار في الهاتف لتجنّب تكرار السؤال — هذا اختيارك وحدك.
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- step 4: التحقق والإنهاء -->
                    <StackPanel x:Name="StepVerifyPanel" Visibility="Collapsed">
                        <TextBlock Text="التحقق والإنهاء" Style="{StaticResource Text.Body}" FontWeight="Bold" FontSize="16"/>
                        <Border x:Name="ReadyCard" Style="{StaticResource Card.Surface}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock x:Name="ReadyDeviceName" Style="{StaticResource Text.Body}" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock x:Name="ReadySerial" Style="{StaticResource Text.Mono}" VerticalAlignment="Center"/>
                                    <Border Background="{StaticResource Brush.Surface.Inset}"
                                            BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Badge}" Padding="7,1" Margin="10,0,0,0">
                                        <TextBlock x:Name="ReadyConnection" Style="{StaticResource Text.Mono}" FontSize="10"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="NotReadyHint" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>
                    </StackPanel>

                    <!-- shared "why do we need this" toggle -->
                    <StackPanel Margin="0,16,0,0">
                        <Button x:Name="WhyToggleBtn" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                Content="لماذا نحتاج هذا؟" Click="WhyToggle_Click" TabIndex="4"
                                AutomationProperties.Name="لماذا نحتاج هذا؟"/>
                        <TextBlock x:Name="WhyText" Visibility="Collapsed" Style="{StaticResource Text.Secondary}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ===================== footer ===================== -->
            <Grid Grid.Row="5" Margin="24,16,24,22">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="LeftToRight">
                    <Button x:Name="BackBtn" Style="{StaticResource Button.Ghost}" Content="السابق" Click="Back_Click"
                            TabIndex="5" AutomationProperties.Name="السابق"/>
                    <Button x:Name="NextBtn" Style="{StaticResource Button.Ghost}" Content="التالي" Click="Next_Click"
                            Margin="8,0,0,0" TabIndex="6" AutomationProperties.Name="التالي"/>
                    <Button x:Name="VerifyBtn" Style="{StaticResource Button.Ghost}" Content="تحقق من الاتصال"
                            Click="Verify_Click" Margin="8,0,0,0" TabIndex="7" AutomationProperties.Name="تحقق من الاتصال الآن"/>
                </StackPanel>
                <Button x:Name="FinishBtn" Style="{StaticResource Button.Primary}" Content="إنهاء"
                        HorizontalAlignment="Right" MinWidth="140" Click="Finish_Click" TabIndex="8"
                        AutomationProperties.Name="إنهاء الإعداد"/>
            </Grid>
        </Grid>
    </Border>
</Window>
