<Window x:Class="ScrcpyDeck.Windows.ConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سياسة الاستخدام" Height="650" Width="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" FlowDirection="RightToLeft"
        FontFamily="{StaticResource Ui}">
    <Border Background="{StaticResource Bg}" BorderBrush="#33302A" BorderThickness="1" CornerRadius="14">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,26,0,10">
                <Image x:Name="Logo" Width="64" Height="64" HorizontalAlignment="Center"/>
                <TextBlock FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,2">
                    <Run Text="PhoneLink" Foreground="{StaticResource Text}"/><Run Text=" Pro" Foreground="{StaticResource Adb}"/>
                </TextBlock>
                <TextBlock Text="سياسة الخصوصية واتفاقية الاستخدام" FontSize="12.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- policy -->
            <Border Grid.Row="1" Style="{StaticResource Cardish}" Margin="24,10" Background="#0C0D11" Padding="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <TextBlock x:Name="PolicyBox" FontSize="12.5" Foreground="{StaticResource Text}" TextWrapping="Wrap" LineHeight="22"/>
                </ScrollViewer>
            </Border>

            <!-- footer -->
            <StackPanel Grid.Row="2" Margin="24,4,24,22">
                <CheckBox x:Name="AgreeCheck" Style="{StaticResource Switch}" Content="قرأتُ الشروط أعلاه وأوافق عليها بالكامل"
                          Margin="0,0,0,14" Checked="Agree_Changed" Unchecked="Agree_Changed"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource GhostButton}" Content="رفض وإغلاق" HorizontalAlignment="Left" Click="Decline_Click"/>
                    <Button Grid.Column="1" x:Name="AcceptBtn" Style="{StaticResource PrimaryButton}" Content="أوافق وأبدأ الاستخدام"
                            Padding="22,11" IsEnabled="False" Click="Accept_Click"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
