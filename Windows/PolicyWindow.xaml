<Window x:Class="ScrcpyDeck.Windows.PolicyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سياسة الخصوصية" Height="600" Width="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" FlowDirection="RightToLeft"
        FontFamily="{StaticResource Ui}">
    <Border Background="{StaticResource Bg}" BorderBrush="#33302A" BorderThickness="1" CornerRadius="14">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="24,18,18,6">
                <TextBlock Text="سياسة الخصوصية واتفاقية الاستخدام" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Left" Style="{StaticResource ChromeButton}" Click="Close_Click">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                </Button>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Cardish}" Margin="24,6" Background="#0C0D11">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="PolicyBox" FontSize="12.5" Foreground="{StaticResource Text}" TextWrapping="Wrap" LineHeight="22"/>
                </ScrollViewer>
            </Border>
            <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" Content="إغلاق" HorizontalAlignment="Left" Margin="24,6,0,20" Padding="26,10" Click="Close_Click"/>
        </Grid>
    </Border>
</Window>
