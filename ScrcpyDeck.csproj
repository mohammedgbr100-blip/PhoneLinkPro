<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PhoneLinkPro</AssemblyName>
    <RootNamespace>ScrcpyDeck</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <Product>PhoneLink Pro</Product>
    <AssemblyTitle>PhoneLink Pro</AssemblyTitle>
    <Company>ENG. Mohammed Sattar</Company>
    <Authors>ENG. Mohammed Sattar</Authors>
    <Copyright>© 2026 ENG. Mohammed Sattar. All rights reserved.</Copyright>
    <Description>PhoneLink Pro — لوحة تحكم احترافية للأندرويد</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The test project lives under tests\ inside this repo. The SDK globs **\*.cs by
         default, so it must be excluded from the application project entirely. This also
         keeps test assemblies out of the application publish output. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Regression tests exercise internal pure helpers extracted for testability. -->
  <ItemGroup>
    <InternalsVisibleTo Include="PhoneLinkPro.Tests" />
  </ItemGroup>

  <!-- SEC-01: expected engine hashes ride INSIDE the assembly as read-only trusted data,
       never as a loose editable file beside the user-writable engine folder. The tracked
       manifest is regenerated only by the explicit developer step update-engine-manifest.bat
       (normal IDE builds never rewrite it); the Condition lets a fresh clone build once so
       that step can bootstrap the file. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\engine.manifest"
                      LogicalName="PhoneLinkPro.engine.manifest"
                      Condition="Exists('Resources\engine.manifest')" />
  </ItemGroup>

  <!-- Release: no loose .pdb in the distributable -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Runtime assets (window/title icon + brand marks) -->
  <ItemGroup>
    <Content Include="Assets\app.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\logo_hero.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Third-party notices + licence texts (must ship with build, publish and installer) -->
  <ItemGroup>
    <Content Include="THIRD-PARTY-NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Licenses\*.txt">
      <Link>Licenses\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Engine binaries (identity hidden: renamed, placed in an "engine" folder) -->
  <ItemGroup>
    <EngineDll Include="..\scrcpy\*.dll" />
  </ItemGroup>

  <Target Name="CopyEngineToBuild" AfterTargets="Build">
    <Copy SourceFiles="..\scrcpy\scrcpy.exe"    DestinationFiles="$(OutDir)engine\PhoneLink.Engine.exe" SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\scrcpy\adb.exe"       DestinationFiles="$(OutDir)engine\PhoneLink.Bridge.exe" SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\scrcpy\scrcpy-server" DestinationFiles="$(OutDir)engine\core.dat"             SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(EngineDll)"            DestinationFolder="$(OutDir)engine"                     SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyEngineToPublish" AfterTargets="Publish">
    <Copy SourceFiles="..\scrcpy\scrcpy.exe"    DestinationFiles="$(PublishDir)engine\PhoneLink.Engine.exe" SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\scrcpy\adb.exe"       DestinationFiles="$(PublishDir)engine\PhoneLink.Bridge.exe" SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\scrcpy\scrcpy-server" DestinationFiles="$(PublishDir)engine\core.dat"             SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(EngineDll)"            DestinationFolder="$(PublishDir)engine"                     SkipUnchangedFiles="true" />
  </Target>

  <!-- SEC-01 publish gate: a Release publish FAILS when a mandatory engine file is missing
       or the engine bundle disagrees with the embedded manifest. Runs the freshly published
       exe in its hidden verify mode (exit 0 = valid), so the exact runtime verification code
       is what validates the exact publish output — no second implementation to drift.
       Escape hatch for diagnostics only: -p:PlpSkipPublishIntegrityCheck=true -->
  <Target Name="VerifyEngineIntegrityAfterPublish" AfterTargets="CopyEngineToPublish"
          Condition="'$(Configuration)'=='Release' and '$(PlpSkipPublishIntegrityCheck)'!='true'">
    <Exec Command="&quot;$(PublishDir)$(AssemblyName).exe&quot;"
          EnvironmentVariables="PLP_INTEGRITY_TOOL=verify" />
    <Message Importance="high"
             Text="PhoneLink Pro: engine bundle verified against the embedded integrity manifest." />
  </Target>

</Project>
