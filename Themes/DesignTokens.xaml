<!-- ============================================================================
     PhoneLink Pro 2.0 — semantic design tokens (Batch 3A).
     Source of truth: approved Direction D design baseline — Batch 2B, approved
     2026-07-25. This dictionary IS the versioned record of that baseline; the
     values below are authoritative and change only by an approved design decision.

     Naming is by VISUAL/SEMANTIC PURPOSE only — never by underlying technology.
     Legacy feature pages keep using Theme.xaml until they are migrated.
     ============================================================================ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===================== colors ===================== -->
    <!-- application + shell backgrounds -->
    <Color x:Key="Color.App.Background">#0C0D10</Color>
    <Color x:Key="Color.Shell.Background">#0A0B0E</Color>

    <!-- surfaces -->
    <Color x:Key="Color.Surface.Raised">#14151A</Color>
    <Color x:Key="Color.Surface.RaisedAlt">#1B1D24</Color>
    <Color x:Key="Color.Surface.Inset">#0D1420</Color>
    <Color x:Key="Color.Surface.Hover">#1A1B20</Color>
    <Color x:Key="Color.Surface.Selected">#15161C</Color>

    <!-- device-space navy (the selected-device stage family) -->
    <Color x:Key="Color.DeviceSpace.Top">#0E1626</Color>
    <Color x:Key="Color.DeviceSpace.Bottom">#0B1220</Color>

    <!-- borders / dividers -->
    <Color x:Key="Color.Border.Subtle">#262932</Color>
    <Color x:Key="Color.Border.Strong">#333744</Color>

    <!-- text -->
    <Color x:Key="Color.Text.Primary">#EDEBE5</Color>
    <Color x:Key="Color.Text.Secondary">#B4B6BF</Color>
    <Color x:Key="Color.Text.Muted">#8A8D96</Color>
    <Color x:Key="Color.Text.OnAccent">#16130A</Color>
    <Color x:Key="Color.Text.OnDanger">#1C0E0B</Color>

    <!-- gold brand / primary action -->
    <Color x:Key="Color.Accent.Primary">#C9A24B</Color>
    <Color x:Key="Color.Accent.Bright">#E3C070</Color>
    <Color x:Key="Color.Accent.FillTop">#D8B25A</Color>
    <Color x:Key="Color.Accent.SoftBackground">#221B0E</Color>

    <!-- semantic states -->
    <Color x:Key="Color.State.Live">#46D5C8</Color>
    <Color x:Key="Color.State.Success">#5FBF6E</Color>
    <Color x:Key="Color.State.Warning">#E0A93B</Color>
    <Color x:Key="Color.State.Danger">#E06B5E</Color>
    <Color x:Key="Color.State.DangerFillBottom">#D05A4D</Color>
    <Color x:Key="Color.State.DangerHoverText">#F0968B</Color>

    <!-- danger banner (integrity) -->
    <Color x:Key="Color.Banner.DangerBackground">#2E1B18</Color>
    <Color x:Key="Color.Banner.DangerBorder">#4A2A24</Color>
    <Color x:Key="Color.Banner.DangerText">#F1E4E0</Color>

    <!-- focus + overlay -->
    <Color x:Key="Color.Focus.Outline">#E3C070</Color>
    <Color x:Key="Color.Overlay.Scrim">#8C050608</Color>

    <!-- ===================== brushes ===================== -->
    <SolidColorBrush x:Key="Brush.App.Background" Color="{StaticResource Color.App.Background}"/>
    <SolidColorBrush x:Key="Brush.Shell.Background" Color="{StaticResource Color.Shell.Background}"/>

    <SolidColorBrush x:Key="Brush.Surface.Raised" Color="{StaticResource Color.Surface.Raised}"/>
    <SolidColorBrush x:Key="Brush.Surface.RaisedAlt" Color="{StaticResource Color.Surface.RaisedAlt}"/>
    <SolidColorBrush x:Key="Brush.Surface.Inset" Color="{StaticResource Color.Surface.Inset}"/>
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{StaticResource Color.Surface.Hover}"/>
    <SolidColorBrush x:Key="Brush.Surface.Selected" Color="{StaticResource Color.Surface.Selected}"/>

    <LinearGradientBrush x:Key="Brush.DeviceSpace.Surface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Color.DeviceSpace.Top}" Offset="0"/>
        <GradientStop Color="{StaticResource Color.DeviceSpace.Bottom}" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{StaticResource Color.Border.Subtle}"/>
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Border.Strong}"/>

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}"/>
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Muted}" Opacity="0.7"/>
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="{StaticResource Color.Text.OnAccent}"/>
    <SolidColorBrush x:Key="Brush.Text.OnDanger" Color="{StaticResource Color.Text.OnDanger}"/>

    <SolidColorBrush x:Key="Brush.Accent.Primary" Color="{StaticResource Color.Accent.Primary}"/>
    <SolidColorBrush x:Key="Brush.Accent.Bright" Color="{StaticResource Color.Accent.Bright}"/>
    <SolidColorBrush x:Key="Brush.Accent.SoftBackground" Color="{StaticResource Color.Accent.SoftBackground}"/>
    <LinearGradientBrush x:Key="Brush.Accent.Fill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Color.Accent.FillTop}" Offset="0"/>
        <GradientStop Color="{StaticResource Color.Accent.Primary}" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.State.Live" Color="{StaticResource Color.State.Live}"/>
    <SolidColorBrush x:Key="Brush.State.LiveSoftBackground" Color="{StaticResource Color.State.Live}" Opacity="0.12"/>
    <SolidColorBrush x:Key="Brush.State.LiveBorder" Color="{StaticResource Color.State.Live}" Opacity="0.5"/>
    <SolidColorBrush x:Key="Brush.State.Success" Color="{StaticResource Color.State.Success}"/>
    <SolidColorBrush x:Key="Brush.State.Warning" Color="{StaticResource Color.State.Warning}"/>
    <SolidColorBrush x:Key="Brush.State.Danger" Color="{StaticResource Color.State.Danger}"/>
    <SolidColorBrush x:Key="Brush.State.DangerBorder" Color="{StaticResource Color.State.Danger}" Opacity="0.55"/>
    <SolidColorBrush x:Key="Brush.State.DangerHoverText" Color="{StaticResource Color.State.DangerHoverText}"/>
    <LinearGradientBrush x:Key="Brush.State.DangerFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Color.State.Danger}" Offset="0"/>
        <GradientStop Color="{StaticResource Color.State.DangerFillBottom}" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Banner.DangerBackground" Color="{StaticResource Color.Banner.DangerBackground}"/>
    <SolidColorBrush x:Key="Brush.Banner.DangerBorder" Color="{StaticResource Color.Banner.DangerBorder}"/>
    <SolidColorBrush x:Key="Brush.Banner.DangerText" Color="{StaticResource Color.Banner.DangerText}"/>

    <SolidColorBrush x:Key="Brush.Focus.Outline" Color="{StaticResource Color.Focus.Outline}"/>
    <SolidColorBrush x:Key="Brush.Overlay.Scrim" Color="{StaticResource Color.Overlay.Scrim}"/>

    <!-- ===================== typography ===================== -->
    <!-- Tajawal is preferred when installed (matches the design reference); Segoe UI is the
         guaranteed system fallback. No font files are bundled. -->
    <FontFamily x:Key="Font.UI">Tajawal, Segoe UI, Tahoma</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <sys:Double x:Key="FontSize.PageTitle">26</sys:Double>
    <sys:Double x:Key="FontSize.PageTitleCompact">22</sys:Double>
    <sys:Double x:Key="FontSize.Title">16</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle">15</sys:Double>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.BodySmall">13.5</sys:Double>
    <sys:Double x:Key="FontSize.Secondary">12.5</sys:Double>
    <sys:Double x:Key="FontSize.Caption">11.5</sys:Double>
    <sys:Double x:Key="FontSize.Small">11</sys:Double>
    <sys:Double x:Key="FontSize.Tiny">10.5</sys:Double>

    <FontWeight x:Key="FontWeight.Regular">Normal</FontWeight>
    <FontWeight x:Key="FontWeight.Medium">Medium</FontWeight>
    <FontWeight x:Key="FontWeight.Bold">Bold</FontWeight>

    <!-- ===================== corner radii ===================== -->
    <CornerRadius x:Key="Radius.Badge">5</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Card">8</CornerRadius>
    <CornerRadius x:Key="Radius.Dialog">10</CornerRadius>
    <CornerRadius x:Key="Radius.Panel">14</CornerRadius>

    <!-- ===================== spacing scale ===================== -->
    <sys:Double x:Key="Space.XSmall">4</sys:Double>
    <sys:Double x:Key="Space.Small">8</sys:Double>
    <sys:Double x:Key="Space.Medium">12</sys:Double>
    <sys:Double x:Key="Space.Large">16</sys:Double>
    <sys:Double x:Key="Space.XLarge">24</sys:Double>
    <sys:Double x:Key="Space.Page">36</sys:Double>
    <Thickness x:Key="Thickness.PagePadding">36</Thickness>
    <Thickness x:Key="Thickness.PagePaddingCompact">24</Thickness>
    <Thickness x:Key="Thickness.CardPadding">12</Thickness>

    <!-- ===================== control + shell sizes ===================== -->
    <sys:Double x:Key="Size.ControlHeight">36</sys:Double>
    <sys:Double x:Key="Size.ControlHeightLarge">44</sys:Double>
    <sys:Double x:Key="Size.NavItemHeight">42</sys:Double>
    <sys:Double x:Key="Size.TitleBarHeight">44</sys:Double>
    <sys:Double x:Key="Size.StatusStripHeight">30</sys:Double>
    <sys:Double x:Key="Size.CaptionButtonWidth">40</sys:Double>
    <sys:Double x:Key="Size.CaptionButtonHeight">30</sys:Double>
    <sys:Double x:Key="Size.IconButton">30</sys:Double>
    <sys:Double x:Key="Size.SidebarWidth">248</sys:Double>
    <sys:Double x:Key="Size.SidebarCompactWidth">64</sys:Double>
    <sys:Double x:Key="Size.DeviceTile">40</sys:Double>
    <GridLength x:Key="GridLength.TitleBar">44</GridLength>
    <GridLength x:Key="GridLength.StatusStrip">30</GridLength>

    <!-- ===================== icon sizes ===================== -->
    <sys:Double x:Key="Size.IconSmall">14</sys:Double>
    <sys:Double x:Key="Size.Icon">18</sys:Double>
    <sys:Double x:Key="Size.IconCompact">20</sys:Double>
    <sys:Double x:Key="Size.IconLarge">22</sys:Double>

    <!-- ===================== opacity ===================== -->
    <sys:Double x:Key="Opacity.Disabled">0.55</sys:Double>
    <sys:Double x:Key="Opacity.InertContent">0.35</sys:Double>
    <sys:Double x:Key="Opacity.InertSidebar">0.45</sys:Double>

</ResourceDictionary>
