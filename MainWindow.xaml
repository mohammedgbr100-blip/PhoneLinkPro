<Window x:Class="ScrcpyDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PhoneLink Pro" Height="720" Width="1120"
        MinHeight="560" MinWidth="920"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource Ui}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="50" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#33302A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===================== TITLE BAR ===================== -->
            <Grid Grid.Row="0" Background="{StaticResource SidebarBg}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- logo + name (right side in RTL) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                            FlowDirection="LeftToRight">
                    <Image x:Name="TitleIcon" Width="26" Height="26" Margin="0,0,10,0"/>
                    <TextBlock FontSize="16" FontWeight="Bold" VerticalAlignment="Center">
                        <Run Text="PhoneLink" Foreground="{StaticResource Text}"/><Run Text=" Pro" Foreground="{StaticResource Adb}"/>
                    </TextBlock>
                    <Border Background="#211B0E" CornerRadius="5" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.1" FontSize="10" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Adb}"/>
                    </Border>
                </StackPanel>

                <!-- window controls (left side in RTL) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            FlowDirection="LeftToRight">
                    <Button x:Name="BtnHelp" Style="{StaticResource ChromeButton}" Click="Help_Click" ToolTip="الشرح التعليمي">
                        <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                    <Button x:Name="BtnAbout" Style="{StaticResource ChromeButton}" Click="About_Click" ToolTip="حول البرنامج">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                    <Border Width="1" Height="20" Background="#2A2620" Margin="6,0" VerticalAlignment="Center"/>
                    <Button x:Name="BtnMin" Style="{StaticResource ChromeButton}" Click="Minimize_Click" ToolTip="تصغير">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                    <Button x:Name="BtnMax" Style="{StaticResource ChromeButton}" Click="Maximize_Click" ToolTip="تكبير">
                        <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource CloseButton}" Click="Close_Click" ToolTip="إغلاق">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ ENGINE INTEGRITY BANNER (hidden unless verification fails) ============ -->
            <Border x:Name="IntegrityBanner" Grid.Row="1" Visibility="Collapsed"
                    Background="#3A1E1B" BorderBrush="{StaticResource Danger}" BorderThickness="0,0,0,1"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{StaticResource Danger}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" x:Name="IntegrityBannerText" TextWrapping="Wrap" FontSize="13"
                               Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" x:Name="IntegrityRetryBtn" Style="{StaticResource GhostButton}"
                            Content="إعادة الفحص" Margin="12,0,0,0" VerticalAlignment="Center"
                            Click="IntegrityRetry_Click"/>
                </Grid>
            </Border>

            <!-- ===================== BODY ===================== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBg}" BorderBrush="#1A1813" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <!-- device chip (bottom) -->
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource Cardish}" Margin="12" Padding="12"
                                Background="#0C0D11" BorderBrush="#26231C">
                            <StackPanel>
                                <TextBlock Text="الجهاز الحالي" FontSize="10" Foreground="{StaticResource Muted}" FontFamily="{StaticResource Mono}"/>
                                <TextBlock x:Name="SidebarDeviceName" Text="لا يوجد جهاز" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Ellipse x:Name="SidebarDot" Width="8" Height="8" Fill="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SidebarDeviceState" Text="غير متصل" FontSize="11" Foreground="{StaticResource Muted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- brand footer (bottom, above device chip) -->
                        <TextBlock DockPanel.Dock="Bottom" Text="© 2026 ENG. Mohammed Sattar" FontSize="10"
                                   Foreground="#5A5A62" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                        <!-- nav -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0">
                            <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" Tag="&#xE975;" Content="لوحة الأجهزة" IsChecked="True" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavMirror" Style="{StaticResource NavButton}" Tag="&#xE7F4;" Content="بث الشاشة" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavWireless" Style="{StaticResource NavButton}" Tag="&#xE704;" Content="الاتصال اللاسلكي" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavLauncher" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="خيارات متقدمة" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavApps" Style="{StaticResource NavButton}" Tag="&#xE71D;" Content="إدارة التطبيقات" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavFiles" Style="{StaticResource NavButton}" Tag="&#xE8B7;" Content="نقل الملفات" Checked="Nav_Checked"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- CONTENT -->
                <ContentControl x:Name="PageHost" Grid.Column="1"/>

                <!-- TOASTS (non-blocking notifications, bottom corner) -->
                <StackPanel x:Name="ToastHost" Grid.Column="1" Panel.ZIndex="99"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="20" IsHitTestVisible="False"/>
            </Grid>
        </Grid>
    </Border>
</Window>
